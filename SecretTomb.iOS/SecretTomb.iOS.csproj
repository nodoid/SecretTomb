<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.allthejohnsons.secrettomb</ApplicationId>
    <ApplicationTitle>The Secret of the Tomb</ApplicationTitle>
    <ApplicationVersion>$(BuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <RootNamespace>SecretTomb.iOS</RootNamespace>
    <AssemblyName>SecretTomb</AssemblyName>
    <AppIcon>AppIcon</AppIcon>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <!-- Profiles are installed locally (not in git) from ~/Downloads by tools/build_release.sh:
       devel-secrettomb for devices, rel-secrettomb for the App Store. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodesignKey>Apple Development: Created via API (ZTRSB8B479)</CodesignKey>
    <CodesignProvision>devel-secrettomb</CodesignProvision>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>Apple Distribution: Paul Johnson (3UH7BE38T3)</CodesignKey>
    <CodesignProvision>rel-secrettomb</CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <BuildIpa>true</BuildIpa>
  </PropertyGroup>
  <ItemGroup>
    <!-- Localised home-screen name: "Le Secret du Tombeau" in French. -->
    <BundleResource Include="Resources\**\*.strings" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SecretTomb.Core\SecretTomb.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
