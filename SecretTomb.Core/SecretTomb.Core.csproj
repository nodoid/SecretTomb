<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SecretTomb.Core</RootNamespace>
    <AssemblyName>SecretTomb.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against MonoGame only; each platform head supplies its own MonoGame runtime. -->
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- High-resolution artwork drawn by tools/make_art.py, loaded by name at run time. -->
    <EmbeddedResource Include="Art\*.png" LogicalName="Art.%(Filename).png" />
    <!-- The tomb itself, as a character map (see World/TombMap.cs for the legend). -->
    <EmbeddedResource Include="World\Tomb.map" LogicalName="Tomb.map" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SecretTomb.Tests" />
  </ItemGroup>
</Project>
