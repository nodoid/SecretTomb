<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.allthejohnsons.secrettomb</ApplicationId>
    <ApplicationTitle>The Secret of the Tomb</ApplicationTitle>
    <ApplicationVersion>$(BuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AssemblyName>SecretTomb</AssemblyName>
    <RootNamespace>SecretTomb.Android</RootNamespace>
  </PropertyGroup>
  <!-- Play upload key, if present. The password is never stored: pass it in SECRETTOMB_KEYSTORE_PASS. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And Exists('$(HOME)/keys/secrettomb-upload.jks')">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(HOME)/keys/secrettomb-upload.jks</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>secrettomb</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:SECRETTOMB_KEYSTORE_PASS</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:SECRETTOMB_KEYSTORE_PASS</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SecretTomb.Core\SecretTomb.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
