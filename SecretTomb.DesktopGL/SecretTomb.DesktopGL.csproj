<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop OpenGL head: used for the macOS app (and runs on Linux / Windows too). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <AssemblyName>SecretTomb</AssemblyName>
    <RootNamespace>SecretTomb.DesktopGL</RootNamespace>
    <CFBundleIdentifier>uk.co.allthejohnsons.secrettomb</CFBundleIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SecretTomb.Core\SecretTomb.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="macOS/**" />
    <None Include="SecretTomb.icns" />
  </ItemGroup>
</Project>
